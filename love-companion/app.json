{
  "expo": {
    "name": "LOVE",
    "slug": "love-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "love",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0f",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karthi.love"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.karthi.love",
      "versionCode": 1,
      "allowBackup": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_PHONE_STATE",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.SEND",
          "category": ["android.intent.category.DEFAULT"],
          "mimeType": "text/plain"
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LOVE needs location to know where you are.",
          "locationAlwaysPermission": "LOVE uses background location to keep your context updated.",
          "locationWhenInUsePermission": "LOVE needs location to know where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c084fc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
