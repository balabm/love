# Project LOVE — Environment Variables
# Copy this file to .env and fill in your values
# Most settings are now in settings.yaml — use that for configuration

# Chrome DevTools Protocol (for browser monitoring)
CHROME_DEBUG_PORT=9222       # Default Chrome remote debugging port

# API Configuration
LOVE_API_URL=http://localhost:8000
LOVE_API_KEY=love-dev-key


# LLM Model Configuration (fallbacks if not in settings.yaml)
OLLAMA_BASE_URL=http://localhost:11434
REASONING_MODEL=deepseek-r1:7b
CODING_MODEL=qwen2.5-coder:7b
EMBED_MODEL=nomic-embed-text

# Device Identity (auto-detected from hostname if not set)
LOVE_DEVICE_ID=
LOVE_DEVICE_TYPE=          # desktop, laptop, gaming, mobile

# Legacy: Development Project Paths (moved to settings.yaml)
# LOVE_WORK_PROJECT=
# LOVE_DOTNET_PROJECT=
# LOVE_FLUTTER_PROJECT=
# LOVE_DOCS_URL=

# Optional: Finance API Keys (store securely!)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Optional: External Services
# OPENAI_API_KEY=            # Only if using OpenAI instead of Ollama
# ELEVENLABS_API_KEY=        # For premium TTS voice

# ── DEVICE INTEGRATIONS ──

# Phone / Tablet via KDE Connect (Android)
# PHONE_DEVICE_ID=           # Device name shown in KDE Connect app (e.g. "Karthi's OnePlus")
# KDE_CONNECT_PORT=1716      # Default KDE Connect port

# Microsoft 365 (Outlook, Teams, Calendar, OneDrive)
# Get Client ID from: https://portal.azure.com → App registrations → New
# MICROSOFT_CLIENT_ID=       # Azure App Registration client ID (e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# MICROSOFT_TENANT_ID=common # Use 'common' for personal + work accounts

# ── AUTONOMOUS AGI LOOP CONFIGURATION ──
# Control how often LOVE thinks and acts autonomously

LOVE_SUPERVISOR_INTERVAL_SEC=300     # Supervisor tick interval (5 min)
LOVE_INTELLIGENCE_TICKS=2            # Run intelligence every N ticks (10 min)
LOVE_DAEMON_INTERVAL_MIN=10          # Self-improvement daemon (10 min)
LOVE_GOAL_INTERVAL_SEC=600           # Goal engine cycle (10 min)
LOVE_WAVE_INTERVAL_H=4               # Wave engine cycle (4 hours)
LOVE_RESEARCH_INTERVAL_MIN=10        # Research engine cycle (10 min)
LOVE_SELF_WORK_ON_TICK=true          # Run self-diagnostics on each tick

# ── CLOUDFLARE TUNNEL ──
# Named tunnel for zero-touch phone access from anywhere

CLOUDFLARE_TUNNEL_NAME=love                    # Tunnel name from dashboard
CLOUDFLARE_TUNNEL_ID=                          # Tunnel ID (from dashboard)
TUNNEL_AGENT_ENABLED=true                      # Auto-start tunnel agent
TUNNEL_LOCAL_URL=http://localhost:8000         # Local service URL
TUNNEL_BINARY_PATH=cloudflared                 # Path to cloudflared binary
TUNNEL_MAX_RETRIES=5
TUNNEL_RETRY_DELAY_SECONDS=10

# ── REMOTE ACCESS (away from home WiFi) ──
# Option A: Tailscale (recommended, free)
#   Install on home PC + all devices → use Tailscale IP in love-companion Settings
# Option B: Cloudflare Tunnel
#   cloudflared tunnel --url http://localhost:8000
# Option C: ngrok (temporary)
#   ngrok http 8000
